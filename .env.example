# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
ALLOWED_CHAT_ID=your_chat_id_here

# Qwen API (DashScope)
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen-vl-plus
QWEN_TEXT_MODEL=qwen-plus

# 用户基础信息
USER_BMR=1916
USER_WEIGHT_GOAL=75.0
USER_PROTEIN_GOAL_PER_KG=1.8
# 运动热量回补比例：追踪器普遍高估，按真实减重反推校准；1.0=全信，0=忽略
ACTIVE_EATBACK_PCT=0.4
# 每月目标减脂（kg），推荐摄入的缺口据此反推（1kg≈7700kcal）
MONTHLY_LOSS_KG=4.0
# /calibrate 所需的最少样本天数（称重与饮食各自），低于此只报告不建议
CALIBRATE_MIN_DAYS=20

# 定时任务时间（24h格式）
MORNING_CHECK_TIME=08:00
EVENING_SUMMARY_TIME=21:00
WEEKLY_REPORT_DAY=monday

# HealthKit 同步接口密钥（iOS 快捷指令 POST /hk/ingest 时校验）
HK_INGEST_TOKEN=generate_a_random_token_here

# Open Food Facts 请求头（条码查营养时用；建议放一个联系邮箱，OFF 便于联系）
OFF_USER_AGENT=DietControlBot/1.0 (+https://github.com/youruser/yourrepo)

# 企业微信（可选，仅用 Telegram 可留空）
WECOM_PORT=5001
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_USER_ID=
